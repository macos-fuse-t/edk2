[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = ScorpiMemInfoPeiLib
  FILE_GUID                      = 4bc28407-21aa-45b1-af31-a1bf8521096a
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = ArmVirtMemInfoLib|PEIM
  CONSTRUCTOR                    = ScorpiMemInfoPeiLibConstructor

[Sources]
  ScorpiMemInfoLib.c
  ScorpiMemInfoLib.h

[Packages]
  ArmPkg/ArmPkg.dec
  ArmVirtPkg/ArmVirtPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  OvmfPkg/OvmfPkg.dec
  SecurityPkg/SecurityPkg.dec

[FeaturePcd]
  gArmVirtTokenSpaceGuid.PcdTpm2SupportEnabled

[LibraryClasses]
  ArmLib
  BaseLib
  BaseMemoryLib
  DebugLib
  FdtLib
  MemoryAllocationLib
  PcdLib

[Pcd]
  gArmTokenSpaceGuid.PcdFdBaseAddress
  gArmTokenSpaceGuid.PcdFvBaseAddress
  gArmTokenSpaceGuid.PcdSystemMemoryBase
  gArmTokenSpaceGuid.PcdSystemMemorySize
  gEfiSecurityPkgTokenSpaceGuid.PcdActiveTpmInterfaceType
  gEfiSecurityPkgTokenSpaceGuid.PcdCRBIdleByPass
  gEfiSecurityPkgTokenSpaceGuid.PcdTpmBaseAddress
  gEfiSecurityPkgTokenSpaceGuid.PcdTpmInstanceGuid
  gArmVirtTokenSpaceGuid.PcdTpmMmioSize

[FixedPcd]
  gArmTokenSpaceGuid.PcdFdSize
  gArmTokenSpaceGuid.PcdFvSize
  gUefiOvmfPkgTokenSpaceGuid.PcdDeviceTreeInitialBaseAddress

[Guids]
  gEfiTpmDeviceInstanceTpm20DtpmGuid
