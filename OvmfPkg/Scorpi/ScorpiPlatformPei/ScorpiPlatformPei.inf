[Defines]
  INF_VERSION                    = 1.29
  BASE_NAME                      = ScorpiPlatformPei
  FILE_GUID                      = 8a699a4c-ed41-4496-906c-3c8e88d5f95c
  MODULE_TYPE                    = PEIM
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = ScorpiPlatformPeiEntry

#
# The following information is for reference only and not required by the build
# tools.
#
#  VALID_ARCHITECTURES           = X64
#

[Sources]
  ScorpiPlatformPei.c

[Packages]
  EmbeddedPkg/EmbeddedPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  OvmfPkg/OvmfPkg.dec
  SecurityPkg/SecurityPkg.dec
  UefiCpuPkg/UefiCpuPkg.dec

[Guids]
  gEfiMemoryTypeInformationGuid
  gUefiOvmfPkgPlatformInfoGuid

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  HobLib
  MemoryAllocationLib
  PcdLib
  PeiServicesLib
  PeimEntryPoint
  PlatformInitLib
  QemuFwCfgLib
  ResourcePublicationLib
  ScorpiHwInfoLib

[Pcd]
  gEfiMdeModulePkgTokenSpaceGuid.PcdEmuVariableNvStoreReserved
